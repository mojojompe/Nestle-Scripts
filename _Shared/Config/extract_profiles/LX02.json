        "Stock Category": "nsp_stock_category",
        "Batch": "nsp_batch",
        "Storage Type": "nsp_storagetype",
        "Storage Bin": "nsp_storagebin",
        "Available stock": "nsp_available_stock",
        "Base Unit of Measure": "nsp_uom",
